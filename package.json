{
  "name": "escuchar",
  "productName": "Escuchar",
  "version": "1.0.0",
  "description": "Tu música: listas de Spotify, Apple Music y YouTube, favoritas e historial, sin descargar nada.",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "Eric Cid",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node --test --test-concurrency=1 \"test/server/*.test.js\" \"test/security/*.test.js\"",
    "test:security": "node --test --test-concurrency=1 \"test/security/*.test.js\"",
    "test:ui": "vitest run",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev --audit-level=high",
    "fetch-ytdlp": "node scripts/fetch-ytdlp.js",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "build": {
    "appId": "com.escuchar.app",
    "productName": "Escuchar",
    "asar": false,
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Escuchar-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Escuchar",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
